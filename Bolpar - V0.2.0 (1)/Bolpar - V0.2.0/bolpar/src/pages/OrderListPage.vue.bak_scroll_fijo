            </q-item-section>
          </q-item>
        </q-list>
      </section>

      <section v-if="activeModule === 'orders'" class="orders-panel">
        <div class="top-row">
          <div class="section-title">Listado de órdenes</div>

          <q-btn-group rounded flat class="status-filter">
            <q-btn

              </q-item-label>
            </q-item-section>
          </q-item>
        </q-list>
      </section>
    </main>
  </q-page>
</template>

<script setup lang="ts">
import { computed, onMounted, ref } from 'vue';
import { useRouter } from 'vue-router';
import OrderListItem from 'src/components/orders/OrderListItem.vue';
import LoadingBox from 'src/components/LoadingBox.vue';
import type { Order } from 'src/queries/models/order.model';

import type { MachineProcess } from 'src/queries/models/machines.model';
import { useGetOtStatusOrders } from 'src/queries/ot-status.query';

import { useGetOrders } from 'src/queries/orders.query';
import { useGetMachinesQuery } from 'src/queries/get-ot-machines.query';
import { useProcessStore } from 'src/stores/process.store';
import { useUserStore } from 'src/stores/user.store';
import { useGetEmployees } from 'src/queries/get-employees-query';
import { getActionHistory, type ActionHistoryItem } from 'src/utils/action/history';
import { api } from 'src/boot/axios';

import {
  downloadCompletedOrderExcel,
  useGetCompletedOrders,
  type CompletedOrder,
} from 'src/queries/completed-orders.query';

type OrderStatusFilter = 'all' | 'pending' | 'finished';
type ActiveModule =
  | 'orders'
  | 'employees'
  | 'otStatus'
  | 'completedOrders'
  | 'history';

const router = useRouter();
const userStore = useUserStore();
const processStore = useProcessStore();

const { orders, isGettingOrders } = useGetOrders();
const { getMachines, isLoadingMachines } = useGetMachinesQuery();
const { employees } = useGetEmployees();

const {
  statusOrders,
  isGettingStatusOrders,
} = useGetOtStatusOrders();

const { completedOrders, isGettingCompletedOrders } = useGetCompletedOrders();

const searchText = ref('');
const employeeSearch = ref('');
const completedOrderSearch = ref('');

const otStatusSearch = ref('');
const expandedOtId = ref<number | null>(null);
const loadingOtStatusId = ref<number | null>(null);

const machinesByOrder = ref<Record<number, MachineProcess[]>>({});

const exportingOrderId = ref<number | null>(null);

const orderStatusFilter = ref<OrderStatusFilter>('all');
const activeModule = ref<ActiveModule>('orders');
const actions = ref<ActionHistoryItem[]>(getActionHistory());

const setModule = (module: ActiveModule) => {
  activeModule.value = module;
};

const setOrderFilter = (filter: OrderStatusFilter) => {
  orderStatusFilter.value = filter;
};

const filteredActions = computed(() => actions.value);

const lastTenActions = computed(() => filteredActions.value.slice(0, 10));

const filteredEmployees = computed(() => {
  const text = employeeSearch.value.toLowerCase();

  if (!text) return employees.value;

  return employees.value.filter((employee) => employee.name.toLowerCase().includes(text));
});

const filteredStatusOrders = computed(() => {
  const text = otStatusSearch.value.trim().toLowerCase();

  if (!text) {
    return statusOrders.value;
  }

  return statusOrders.value.filter((order) =>
    [
      order.id,
      order.so_number,
      order.subject,
      order.account_name,
    ]
      .join(' ')
      .toLowerCase()
      .includes(text),
  );
});

const filteredCompletedOrders = computed(() => {
  const text = completedOrderSearch.value.toLowerCase();

  if (!text) return completedOrders.value;

  return completedOrders.value.filter((order) =>
    [order.id, order.so_number, order.subject, order.status, order.finished_at]
      .join(' ')
      .toLowerCase()
      .includes(text),
  );
});

const handleExportCompletedOrder = async (order: CompletedOrder) => {
  try {
    exportingOrderId.value = order.id;
    await downloadCompletedOrderExcel(order);
  } finally {
    exportingOrderId.value = null;
  }
};

const handleViewStockCrm = (order: CompletedOrder) => {
  const baseURL = api.defaults.baseURL || '';

  const url = `${baseURL}inventario/orders/${order.id}/resumen-stock-crm/`;

  window.open(url, '_blank');
};

const filteredOrders = computed(() => {
  const byStatus =
    orderStatusFilter.value === 'all'
      ? orders.value
      : orders.value.filter((order) =>
          orderStatusFilter.value === 'finished'
            ? order.machine_flow_status === 'finished'
            : order.machine_flow_status === 'pending',
        );

  const text = searchText.value.toLowerCase();

  return text.length === 0
    ? byStatus
    : byStatus.filter((order) =>
        [order.id, order.subject, order.account_name, order.due_date]
          .join(' ')
          .toLowerCase()
          .includes(text),
      );
});

onMounted(() => {
  processStore.removeSelectedOrder();
  actions.value = getActionHistory();
});

const handleLogout = () => {
  processStore.removeSelectedOrder();
  userStore.logout();
  delete api.defaults.headers.common.Authorization;
  void router.push('/');
};

const normalizeMachineText = (value: string | number | null | undefined) =>
  String(value ?? '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const getMachineCode = (value?: string) => {
  const match = normalizeMachineText(value).match(/^(\d+)/);
  return match?.[1] ?? '';
};

const normalizeOtStatusText = (
  value: string | number | null | undefined,
) =>
  String(value ?? '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

const findMachineForPlan = (
  orderId: number,
  machineName: string,
) => {
  const machines = machinesByOrder.value[orderId] ?? [];

  const planCode = getMachineCode(machineName);

  const candidates = machines.filter((machine) => {
    const machineCode = getMachineCode(machine.nombre);

    if (planCode && machineCode) {
      return planCode === machineCode;
    }

    return (
      normalizeOtStatusText(machine.nombre) ===
      normalizeOtStatusText(machineName)
    );
  });

  /*
   * Si por algún motivo histórico hubiera más de una máquina
   * para la misma línea, tomamos la más nueva.
   */
  return [...candidates].sort(
    (a, b) => Number(b.id) - Number(a.id),
  )[0];
};

const getMachineLastStatus = (
  machine?: MachineProcess,
): string => {
  if (!machine?.status_logs?.length) {
    return '';
  }

  const sortedStatuses = [...machine.status_logs].sort(
    (a, b) =>
      new Date(b.fecha_hora).getTime() -
      new Date(a.fecha_hora).getTime(),
  );

  return sortedStatuses[0]?.estado ?? '';
};

type OtMachineVisualStatus =
  | 'not-started'
  | 'in-process'
  | 'paused'
  | 'completed';

const getMachineVisualStatus = (
  orderId: number,
  machineName: string,
): OtMachineVisualStatus => {
  const machine = findMachineForPlan(orderId, machineName);

  if (!machine) {
    return 'not-started';
  }

  const status = getMachineLastStatus(machine);

  switch (status) {
    case 'FINISHED':
      return 'completed';

    case 'PAUSED':
      return 'paused';

    case 'STARTED':
    case 'PRODUCCION':
      return 'in-process';

    default:
      return 'not-started';
  }
};

const getMachineStatusLabel = (
  orderId: number,
  machineName: string,
) => {
  const status = getMachineVisualStatus(orderId, machineName);

  switch (status) {
    case 'completed':
      return 'Completado';

    case 'paused':
      return 'En pausa';

    case 'in-process':
      return 'En proceso';

    default:
      return 'Sin iniciar';
  }
};

const toggleOtStatus = async (order: Order) => {
  /*
   * Si presionamos la misma OT abierta, se cierra.
   */
  if (expandedOtId.value === order.id) {
    expandedOtId.value = null;
    return;
  }

  /*
   * Abrir esta OT cierra automáticamente cualquier otra,
   * porque expandedOtId sólo puede contener un ID.
   */
  expandedOtId.value = order.id;
  loadingOtStatusId.value = order.id;

  try {
    const { data: machines } = await api.get<MachineProcess[]>(
      `inventario/machines/?ot=${order.id}`,
    );

    machinesByOrder.value = {
      ...machinesByOrder.value,
      [order.id]: machines,
    };
  } catch (error) {
    console.error(
      `No se pudieron cargar las máquinas de la OT ${order.id}`,
      error,
    );

    machinesByOrder.value = {
      ...machinesByOrder.value,
      [order.id]: [],
    };
  } finally {
    loadingOtStatusId.value = null;
  }
};

const handleSelectOrder = async (order: Order) => {
  const machines = await getMachines(order.id);
  const currentPlanification = order.planificacion_produccion[0];

  const currentPlanCode = getMachineCode(
    currentPlanification?.linea_new || currentPlanification?.linea,
  );

  const machineForThisModule = machines
    .filter((machine) => getMachineCode(machine.nombre) === currentPlanCode)
    .sort((a, b) => Number(b.id) - Number(a.id))[0];

  processStore.selectOrder(order, machineForThisModule ? [machineForThisModule] : []);

  void router.push(`/orders/${order.id}`);
};
</script>


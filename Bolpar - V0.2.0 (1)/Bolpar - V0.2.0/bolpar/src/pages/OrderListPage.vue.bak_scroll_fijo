                    size="26px"
                  />
                </div>
              </div>
            </div>

            <div
              v-if="expandedOtId === order.id"
              class="ot-status-body"
            >
              <div
                v-if="loadingOtStatusId === order.id"
                class="ot-status-loading"
              >
                <q-spinner
                  color="primary"
                  size="28px"
                />
                <span>Cargando máquinas...</span>
              </div>

              <template v-else>
                <div class="ot-machine-list">
                  <div
                    v-for="(plan, index) in order.planificacion_produccion"
                    :key="`${order.id}-${index}-${plan.linea_new || plan.linea}`"
                    class="ot-machine-row"
                  >
                    <div class="ot-machine-info">
                      <div class="ot-machine-number">
                        {{ index + 1 }}
                      </div>

                      <div class="ot-machine-text">
                        <div class="ot-machine-name">
                          {{
                            plan.linea_new ||
                            plan.linea ||
                            'Máquina sin definir'
                          }}
                        </div>

                        <div
                          v-if="plan.producto"
                          class="ot-machine-product"
                        >
                          {{ plan.producto }}
                        </div>
                      </div>
                    </div>

                    <div
                      class="ot-machine-status"
                      :class="
                        `ot-machine-status--${getMachineVisualStatus(
                          order.id,
                          plan.linea_new || plan.linea,
                        )}`
                      "
                    >
                      <span class="ot-machine-status-dot"></span>
                      {{
                        getMachineStatusLabel(
                          order.id,
                          plan.linea_new || plan.linea,
                        )
                      }}
                    </div>
                  </div>
                </div>

                <div
                  v-if="
                    !order.planificacion_produccion ||
                    order.planificacion_produccion.length === 0
                  "
                  class="ot-status-empty ot-status-empty--compact"
                >
                  <q-icon name="precision_manufacturing" size="30px" />
                  <span>Esta OT no tiene máquinas planificadas.</span>
                </div>
              </template>
            </div>
          </article>
        </div>
      </section>

      <section v-if="activeModule === 'completedOrders'" class="module-panel">
        <div class="top-row q-mb-md">
          <div class="section-title">OT Completadas</div>

          <q-badge color="primary" class="q-pa-sm">
            {{ filteredCompletedOrders.length }} registros
          </q-badge>
        </div>

        <q-input
          v-model="completedOrderSearch"
          dense
          outlined
          rounded
          placeholder="Buscar OT completada"
          class="main-search"
        >
          <template #append>
            <q-icon name="search" />
          </template>
        </q-input>

        <q-list class="completed-orders-list">
          <q-item
            v-for="order in filteredCompletedOrders"
            :key="order.id"
            class="completed-order-item"
          >
            <q-item-section>
              <q-item-label class="text-weight-bold">
                OT {{ order.id }}
              </q-item-label>

              <q-item-label caption lines="2">
                {{ order.subject }}
              </q-item-label>

              <q-item-label caption>
                Máquinas: {{ order.machines_count }} / {{ order.plan_count }}
                · Estado: {{ order.status || '-' }}
                · Finalizado: {{ order.finished_at || '-' }}
              </q-item-label>
            </q-item-section>

            <q-item-section side>
              <div class="completed-order-actions">
                <q-btn
                  unelevated

          </q-item>

          <q-item v-if="!isGettingCompletedOrders && filteredCompletedOrders.length === 0">
            <q-item-section>
              <q-item-label class="text-grey-7">
                No hay OT completadas al 100%.
              </q-item-label>
            </q-item-section>
          </q-item>

          <q-item v-if="isGettingCompletedOrders">
            <q-item-section>
              <q-item-label class="text-grey-7">
                Cargando OT completadas...
              </q-item-label>
            </q-item-section>
          </q-item>
        </q-list>
      </section>

      <section v-if="activeModule === 'history'" class="module-panel">
        <div class="section-title">Historial completo de acciones</div>

        <q-list class="action-list">

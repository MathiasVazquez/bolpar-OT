            <q-item-section avatar>
              <q-avatar :color="action.color" text-color="white" size="34px">
                <q-icon :name="action.icon" />
              </q-avatar>
            </q-item-section>

            <q-item-section>
              <q-item-label class="text-weight-bold">
                {{ action.title }}
              </q-item-label>

              <q-item-label caption lines="2">
                {{ action.description }}
              </q-item-label>

              <q-item-label caption class="text-grey-7">
                {{ action.dateTime }}
              </q-item-label>
            </q-item-section>
          </q-item>

          <q-item v-if="filteredActions.length === 0">
            <q-item-section>
              <q-item-label class="text-grey-7">

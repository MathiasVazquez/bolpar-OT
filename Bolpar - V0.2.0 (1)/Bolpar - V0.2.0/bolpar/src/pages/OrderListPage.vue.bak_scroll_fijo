              tabindex="0"
              @click="toggleOtStatus(order)"
              @keyup.enter="toggleOtStatus(order)"
            >
              <div class="ot-status-main">
                <div class="ot-status-id-row">
                  <div class="ot-status-title">
                    OT {{ order.id }}
                  </div>

                  <div
                    v-if="order.so_number"

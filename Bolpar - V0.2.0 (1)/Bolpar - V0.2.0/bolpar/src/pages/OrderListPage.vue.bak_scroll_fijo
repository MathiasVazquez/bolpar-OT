                  >
                    {{ order.so_number }}
                  </div>
                </div>

                <div
                  class="ot-status-subject"
                  :title="order.subject"
                >
                  {{ order.subject || 'Sin descripción' }}
                </div>

                <div class="ot-status-meta">
                  <div
                    v-if="order.account_name"
                    class="ot-status-meta-item"
                  >
                    <q-icon name="business" size="17px" />
                    <span>{{ order.account_name }}</span>
                  </div>

                  <div class="ot-status-meta-item">
                    <q-icon name="precision_manufacturing" size="18px" />
                    <span>
                      {{ order.planificacion_produccion?.length ?? 0 }}
                      máquinas
                    </span>
                  </div>
                </div>
              </div>

              <div class="ot-status-header-actions">
                <div class="ot-status-view-label">
                  {{ expandedOtId === order.id ? 'Ocultar' : 'Ver detalle' }}
                </div>

                <div class="ot-status-chevron">
                  <q-icon
                    :name="
                      expandedOtId === order.id
                        ? 'keyboard_arrow_up'
                        : 'keyboard_arrow_down'
